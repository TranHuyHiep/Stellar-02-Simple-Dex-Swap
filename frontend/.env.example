# Copy to .env.local and edit to point the app at a different deployment.
# Every value has a working default (see src/lib/config.ts), so this file is
# optional for testnet.

VITE_NETWORK=testnet
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_FRIENDBOT_URL=https://friendbot-testnet.stellar.org

# Written by scripts/deploy.sh into deployment.json
VITE_CONTRACT_ID=CD3QTWMRPZCVCKYRLT6EDLBBLLLRKAR7WXXBJSRGX73B65FA7C4EPOFH
VITE_FEE_VAULT_ID=CAIGJ2FLWFDBDTEQILJIO32UGSQP5SJRI7ZON6XFI5JBGJDB657ZQ5AX

VITE_NFT_COLLECTION_ID=CBMIQ343QRVOUGXE7OUPCZNNYGWBDWMS56UALN5NIHWZALN6IDYYYEUV
VITE_NFT_POOL_ID=CBADR5KPKYFMMMMOUWYIZXZ4NZGRWTNPJEUQN6OLGU52OLWALT2CKTZG

# IPFS pinning (Pinata). Without a JWT the mint page still works: the CID is
# computed from the file's bytes, but the image is not pinned.
VITE_PINATA_JWT=
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
